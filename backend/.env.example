# Server
APP_NAME="Multi-Agent Travel Planner"
APP_VERSION="3.0.0"
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Storage
DATA_DIR=data
REPORT_DIR=data/reports
MEMORY_DB_PATH=data/travel_memory.db

# Redis for short-term memory (optional, falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# Live web search/crawling
ENABLE_LIVE_WEB=true
REQUEST_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/125.0 Safari/537.36"
SEARCH_TIMEOUT=12
MAX_SEARCH_RESULTS=6
MAX_CRAWLED_ARTICLES=6

# Tavily search API - QueryAgent uses this for travel research
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search

# Optional custom search API fallback
SEARCH_API_URL=
SEARCH_API_KEY=

# ==========================================
# SiliconFlow LLM Configuration (Unified)
# ==========================================
# All agents use SiliconFlow models with different complexity levels.
# API docs: https://docs.siliconflow.cn/

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Default model (fallback for all agents)
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# ==========================================
# Per-Agent Model Configuration
# ==========================================
# Each agent can use a different model based on task complexity:
# - 7B: Lightweight routing, structured output (Total, Strategy, Report)
# - 14B: Medium complexity understanding (Query)
# - 32B: Deep analysis, multi-source integration (Analysis)

# TotalAgent - lightweight routing
TOTAL_AGENT_MODEL=Qwen/Qwen2.5-7B-Instruct
TOTAL_AGENT_TIMEOUT=30
TOTAL_AGENT_MAX_TOKENS=500

# StrategyAgent - rule-based transformation
STRATEGY_AGENT_MODEL=Qwen/Qwen2.5-7B-Instruct
STRATEGY_AGENT_TIMEOUT=30
STRATEGY_AGENT_MAX_TOKENS=800

# QueryAgent - medium complexity text understanding
QUERY_AGENT_MODEL=Qwen/Qwen2.5-14B-Instruct
QUERY_AGENT_TIMEOUT=60
QUERY_AGENT_MAX_TOKENS=2000

# AnalysisAgent - deep analysis, highest complexity
ANALYSIS_AGENT_MODEL=Qwen/Qwen2.5-32B-Instruct
ANALYSIS_AGENT_TIMEOUT=90
ANALYSIS_AGENT_MAX_TOKENS=3000

# ReportAgent - structured HTML generation
REPORT_AGENT_MODEL=Qwen/Qwen2.5-7B-Instruct
REPORT_AGENT_TIMEOUT=30
REPORT_AGENT_MAX_TOKENS=1500

# ==========================================
# Legacy OpenAI-compatible Configuration
# ==========================================
# Kept for backward compatibility. SiliconFlow config takes precedence.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=90
LLM_MAX_TOKENS=1600

# QueryAgent-specific legacy model choices
QUERY_LLM_API_KEY=
QUERY_LLM_BASE_URL=
QUERY_LLM_MODEL=
QUERY_QUERY_MODEL=
QUERY_EXTRACTION_MODEL=
QUERY_SYNTHESIS_MODEL=
QUERY_LLM_TIMEOUT=90
QUERY_LLM_MAX_TOKENS=1800

# Vision model (optional, for image analysis)
ENABLE_VISION=true
VISION_MODEL=gpt-4o-mini

# HuggingFace settings (reserved for future CLIP/image adapters)
HF_TOKEN=
HF_VISION_MODEL=openai/clip-vit-base-patch32

# Map services (Amap/Gaode)
AMAP_API_KEY=

# Image services (Unsplash)
UNSPLASH_ACCESS_KEY=

# PDF export (requires WeasyPrint)
ENABLE_PDF_EXPORT=false
